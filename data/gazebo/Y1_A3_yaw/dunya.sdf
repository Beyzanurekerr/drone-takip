<?xml version="1.0" ?>
<!-- URETILMISTIR - elle duzenlemeyin. Kaynak: gazebo/dunya_uret.py -->
<sdf version="1.9">
  <world name="Y1_A3_yaw">
    <physics name="varsayilan" type="ignored">
      <max_step_size>0.004166666666666667</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.55 0.65 0.80</background_color>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.55 0.65 0.80</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="gunes">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 120 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>

    <!-- zemin: tek buyuk kutu + uretilmis albedo dokusu -->
    <model name="zemin">
      <static>true</static>
      <pose>0 0 -0.10 0 0 0</pose>
      <link name="l">
        <collision name="c">
          <geometry><box><size>560.0 560.0 0.2</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>560.0 560.0 0.2</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>zemin.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="hedef">
      <static>false</static>
      <pose>-24.0 -2.2 0.78395 0 0 0.0</pose>
      <link name="govde">
        <gravity>false</gravity>
        <inertial>
          <mass>1200</mass>
          <inertia><ixx>500</ixx><iyy>2000</iyy><izz>2200</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="mesh">
          <pose>-0.34355 0.0 -0.77261 0.0 0.0 1.5707963267948966</pose>
          <geometry><mesh><scale>0.0254 0.0254 0.0254</scale><uri>/home/beyza/drone_takip/data/gazebo/_assets/hatchback/hatchback.obj</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>4.8 0.0 0.0</initial_linear>
        <initial_angular>0.0 0.0 0.0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>120</update_frequency>
      </plugin>
    </model>

    <model name="celdirici">
      <static>false</static>
      <pose>20.0 2.2 0.75 0 0 3.141592653589793</pose>
      <link name="govde">
        <gravity>false</gravity>
        <inertial>
          <mass>1200</mass>
          <inertia><ixx>500</ixx><iyy>2000</iyy><izz>2200</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="kasa">
          <geometry><box><size>4.6 1.9 1.5</size></box></geometry>
          <material>
            <ambient>0.75 0.65 0.15 1</ambient>
            <diffuse>0.75 0.65 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <visual name="tavan">
          <pose>-0.25 0 0.63 0 0 0</pose>
          <geometry><box><size>2.07 1.52 0.44999999999999996</size></box></geometry>
          <material>
            <ambient>0.3375 0.29250000000000004 0.0675 1</ambient>
            <diffuse>0.3375 0.29250000000000004 0.0675 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>3.5 0.0 0.0</initial_linear>
        <initial_angular>0.0 0.0 0.0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>120</update_frequency>
      </plugin>
    </model>

    <model name="celdirici2">
      <static>false</static>
      <pose>6.0 -9.0 0.75 0 0 2.670353755551324</pose>
      <link name="govde">
        <gravity>false</gravity>
        <inertial>
          <mass>1200</mass>
          <inertia><ixx>500</ixx><iyy>2000</iyy><izz>2200</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="kasa">
          <geometry><box><size>4.6 1.9 1.5</size></box></geometry>
          <material>
            <ambient>0.15 0.62 0.35 1</ambient>
            <diffuse>0.15 0.62 0.35 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <visual name="tavan">
          <pose>-0.25 0 0.63 0 0 0</pose>
          <geometry><box><size>2.07 1.52 0.44999999999999996</size></box></geometry>
          <material>
            <ambient>0.0675 0.279 0.1575 1</ambient>
            <diffuse>0.0675 0.279 0.1575 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>4.2 0.0 0.0</initial_linear>
        <initial_angular>0.0 0.0 0.0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>120</update_frequency>
      </plugin>
    </model>

    <!-- drone: kamera tasiyicisi.
         MODEL DIK DURUR; nadir donusu sensorun kendi <pose>'unda.
         Neden: VelocityControl komutlari GOVDE cercevesindedir. Nadir donus
         model pozunda kalsaydi govde +X'i dunya -Z olurdu ve "ileri git"
         komutu kamerayi asagi surerdi; "yaw" komutu da goruntude yaw degil
         pitch uretirdi. Donus sensore tasininca govde eksenleri dunya
         eksenleriyle ortusur: wz -> goruntu donmesi, wy -> pitch, vx -> saga.
         Kameranin DUNYA pozu = model pozu o sensor pozu; bileske
         gazebo/kaydet.py icinde alinip pozlar.csv'ye kam_* olarak yazilir. -->
    <model name="drone">
      <static>false</static>
      <pose>-24.0 0.0 38.3 0 0 0</pose>
      <link name="govde">
        <gravity>false</gravity>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <sensor name="kam" type="camera">
          <pose>0 0 0 0.0 1.5707963267948966 1.5707963267948966</pose>
          <always_on>1</always_on>
          <update_rate>30.0</update_rate>
          <topic>kamera</topic>
          <camera>
            <horizontal_fov>1.1386263822013238</horizontal_fov>
            <image>
              <width>640</width><height>480</height><format>R8G8B8</format>
            </image>
            <clip><near>0.5</near><far>800</far></clip>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
          </camera>
        </sensor>
        <!-- A11/KOL 1: ego telafisi icin IMU. Sensor GOVDEDE, kamera gibi
             dondurulmus DEGIL: gorsel ego kamera cercevesinde olculuyor,
             IMU govde cercevesinde; donusum okuma tarafinda yapilir
             (kam_roll/pitch/yaw meta.json'da). -->
        <sensor name="imu" type="imu">
          <always_on>1</always_on>
          <update_rate>200.0</update_rate>
          <topic>imu</topic>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>4.8 0.0 0.0</initial_linear>
        <initial_angular>0.0 0.0 0.8224670334241131</initial_angular>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>120</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
