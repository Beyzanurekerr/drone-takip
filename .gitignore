__pycache__/
*.pyc
*.pyo
.DS_Store

# veri kumeleri ve videolar depoya girmesin
data/videos/*
data/datasets/*
!data/*/.gitkeep

# teshis ciktisi (telemetri csv + 4K debug kareleri)
debug/

# Gazebo kayitlari: kare PNG'leri ve zemin dokusu buyuk ve yeniden uretilebilir
# (gazebo/kaydet.py). meta.json + pozlar.csv kalir: kayit kunyesi ve GT kaynagi.
data/gazebo/*/kareler/
data/gazebo/*/zemin.png
data/gazebo/*/gz.log
data/gazebo/*/gz_canli.log

# CANLI (veri/gazebo_canli.py): sabit bir "kayit" DEGIL, her calistirmada
# dunya_yaz() ile YENIDEN uretilen bir dunya - A1_taban vb.nin aksine
# dunya.sdf'i saklamanin bir kayit kunyesi degeri yok.
data/gazebo/Canli*/

# Zemin dokusu onbellegi: seed'li ve gazebo/dunya_uret.py ile yeniden uretilir
data/gazebo/_doku/

# DEMO dali temizligi (chore: demo dali temizligi): arastirma cikti/
# klasoru (fazb_tani.json .. kmod_k1.json, hepsi arastirma-v1'de) SILINDI.
# cikti/demo/{kucul,celdirici,kopus}.mp4 BILEREK ignore edilmiyor - Adim 6a
# geregi git'e girer (kabul senaryolarinin kaniti).

# sim kayitlari: kareler yeniden uretilebilir (veri/sim_kayit.py)
data/sim/*/kareler/

# Model agirliklari (ikili, buyuk) depoya girmez - TEK istisna: demo modunun
# ZORUNLU bagimliligi a6_kucuk_hedef.pt (klonlayan herkeste hazir olsun diye
# commit edilir). yolov8n.pt (opsiyonel --yolo yolu) HALA elle indirilir.
*.pt
!weights/a6_kucuk_hedef.pt

# A6 - uretilmis egitim havuzlari (kaynaktan yeniden uretilebilir)
data/a6/
!data/a6/manifest/

# A6 - egitim ciktilari
runs/

# IMX500 paketleme: yerel arac kurulumlari (buyuk, PC'ye ozel, yeniden kurulabilir)
.venv_imx500/
.jdk/
weights/imx500/calib/images/
