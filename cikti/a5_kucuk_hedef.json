  "metodoloji": {
    "M0_reddedildi": "tum kareyi kucultmek: letterbox uzun kenari 640'a normalize ettigi icin ag girdisinde geri buyutulur; olculdu (117/23 kare1, olcek 1.0/0.5/0.25/0.125 -> tespit 8/7/6/5, guven 0.539/0.572/0.611/0.612)",
    "M1_reddedildi": "gercek arkaplanli FOV kirpma: 5 px seviyesi 19193x10796 px pencere ister, kaynak 2720x1530; en buyuk seviye bile tasiyor",
    "M2_uygulanan": "gercek arkaplan uzerine gercek hedef yamasi; tuval 640x360 sabit; izotropik olcekleme, kontrol edilen degisken UZUN KENAR; arkaplan = hedefe en yakin, hedefi hic icermeyen hucre",
    "arkaplan_olcutu_geri_alindi": "once 'dedektorun hic tespit uretmedigi hucre' secildi; bu olcut yola en az benzeyen bolgeyi seciyor ve native yama 20 karede yalnizca 3 kez bulundu (dokunulmamis karede 20/20) - terk edildi",
    "hareket_konfaundu": "hedefin tuvaldeki hareketi s ile olceklendi; 'kendi eni/kare' 117/23'te 0.0593-0.0737, 137/12'de 0.0189-0.0295 -> seviyeler arasi fark hareketten degil boyuttan",
    "hit_sutunu": "recall_iou0 YOGUN ARKAPLANDA GUVENILMEZ (arkaplandaki aracin kutusu yamayi kapsayabilir); karar olcutu recall_iou50"
  },
  "kabul": {
    "Y8_A": "GECTI - iki birincil dizide 8/8 seviye, TESPIT ve TAKIP bloklarinda eksiksiz",
    "Y8_B": "GECTI - TESPIT metrik alanlari 0 fark, TAKIP 54/54 kol birebir (en buyuk fark 0.0); duvar-saati (gecikme/fps) alanlari haric, 107 alan",
    "Y8_C": "GECTI - 57 seviyesi r@.5 0.975/1.000; kompozit kontrolu 117/23 20->17, 137/12 20->20",
    "Y8_D": "GECTI - minimum guvenilir boyut = uzun kenar 57 px"
